# 複製成 .env 後填入（.env 不要上傳到 GitHub）
# 部署到 GitHub Actions 時，改填在 repo 的 Settings → Secrets and variables → Actions

# 必填（免費版）：Google Gemini 金鑰（https://aistudio.google.com/apikey）
GEMINI_API_KEY=

# 選填（升級版）：Claude API 金鑰（https://console.anthropic.com）
ANTHROPIC_API_KEY=

# 選填：Tavily 搜尋 API（https://tavily.com），沒填就只用 RSS 來源
TAVILY_API_KEY=

# 必填：寄信用的 Gmail 帳號與「應用程式密碼」（不是登入密碼）
# 申請方式：Google 帳戶 → 安全性 → 兩步驟驗證 → 應用程式密碼
SMTP_USER=
SMTP_PASSWORD=

# 必填：收件人，多個用逗號分隔
REPORT_RECIPIENTS=
