{#- 郵件用 HTML：只用 inline style 與 table，Gmail／Outlook／手機都能正常顯示 -#}
{%- macro src(r) -%}{% if r.source_url %}<a href="{{ r.source_url }}" style="color:#1f5fa8;text-decoration:none;">{{ r.source_name or "來源" }} ›</a>{% endif %}{%- endmacro -%}
{%- macro badge(code, label) -%}
{%- set colors = {"A": "#1e7d4f", "B": "#2f6fb0", "C": "#6b6b6b", "D": "#b4580a", "E": "#999999"} -%}
<span style="display:inline-block;padding:1px 7px;border-radius:10px;font-size:11px;line-height:18px;color:#fff;background:{{ colors.get(code, '#6b6b6b') }};">{{ label }}</span>
{%- endmacro -%}
{%- macro tagchip(t) -%}<span style="display:inline-block;padding:1px 7px;margin:2px 4px 0 0;border-radius:10px;font-size:11px;line-height:18px;color:#7a4b00;background:#fff1d6;">★ {{ t }}</span>{%- endmacro -%}
{%- macro h2(text, color="#1f5fa8") -%}<h2 style="font-size:17px;margin:28px 0 10px;padding-left:10px;border-left:4px solid {{ color }};">{{ text }}</h2>{%- endmacro -%}
{%- macro card(c, show_changes=False) -%}
<div style="border:1px solid #e3e6ea;border-radius:10px;padding:12px 14px;margin:0 0 10px;background:#fff;">
  <div style="font-size:15px;font-weight:bold;line-height:1.4;">{{ c.brand }} {{ c.model }}</div>
  <div style="margin:4px 0 6px;">{{ badge(c.conf_code, c.confidence) }} <span style="display:inline-block;padding:1px 7px;border-radius:10px;font-size:11px;line-height:18px;color:{% if c.score_pct >= 70 %}#1e7d4f{% elif c.score_pct >= 40 %}#8a6100{% else %}#b42318{% endif %};background:#f1f3f5;">規格 {{ c.score }}</span>{% if c.options|length > 1 %} <span style="font-size:11px;color:#777;">{{ c.options|length }} 種螢幕選配</span>{% endif %} {% for t in c.tags %}{{ tagchip(t) }}{% endfor %}</div>
  {% for o in c.options %}
  <div style="{% if not loop.first %}border-top:1px dashed #e3e6ea;margin-top:8px;padding-top:8px;{% endif %}">
    {% if c.options|length > 1 %}<div style="font-size:11px;color:#999;">選配 {{ loop.index }}</div>{% endif %}
    {% if o.screen %}<div style="font-size:14px;line-height:1.6;">🖥 {{ o.screen }}</div>{% endif %}
    {% if o.bright %}<div style="font-size:14px;line-height:1.6;">☀ {{ o.bright }}</div>{% endif %}
    <div {% if not o.gamut %}class="d-only" {% endif %}style="font-size:14px;line-height:1.6;{% if not o.gamut %}color:#999;{% endif %}">🎨 {{ o.gamut or "色域：未標示" }}</div>
    <div {% if not o.surface %}class="d-only" {% endif %}style="font-size:14px;line-height:1.6;{% if not o.surface %}color:#999;{% endif %}">◻ {{ ("表面：" ~ o.surface) if o.surface else "表面處理：未標示" }}</div>
    <div {% if not o.touch %}class="d-only" {% endif %}style="font-size:14px;line-height:1.6;{% if not o.touch %}color:#999;{% endif %}">👆 {{ o.touch or "觸控：未標示" }}</div>
    {% if o.optics or o.structure or o.mechanics or o.interface %}
    <div style="font-size:12px;line-height:1.7;color:#555;margin-top:2px;">
      {% if o.optics %}<div>光學｜{{ o.optics }}</div>{% endif %}
      {% if o.structure %}<div>結構｜{{ o.structure }}</div>{% endif %}
      {% if o.mechanics %}<div>機構｜{{ o.mechanics }}</div>{% endif %}
      {% if o.interface %}<div>介面｜{{ o.interface }}</div>{% endif %}
    </div>
    {% endif %}
    <div style="font-size:14px;line-height:1.6;{% if not o.panel_known %}color:#999;{% endif %}">🏭 {{ o.panel }}</div>
    {% if o.extras %}<div style="font-size:13px;line-height:1.6;color:#555;">{{ o.extras }}</div>{% endif %}
    {% if o.price %}<div style="font-size:13px;line-height:1.6;color:#555;">💲 {{ o.price }}</div>{% endif %}
    {% if o.derived %}<div style="font-size:12px;line-height:1.6;color:#888;">{{ o.derived }}</div>{% endif %}
    {% if o.provenance|length > 1 %}<div style="font-size:11.5px;line-height:1.6;color:#888;margin-top:2px;">出處｜{% for p in o.provenance %}{% if p.url %}<a href="{{ p.url }}" style="color:#1f5fa8;text-decoration:none;">{{ p.label }}</a>{% else %}{{ p.label }}{% endif %}：{{ p.fields }}{% if not loop.last %}；{% endif %}{% endfor %}</div>{% endif %}
    {% if o.platform %}<div style="font-size:12px;line-height:1.6;color:#999;">平台：{{ o.platform }}</div>{% endif %}
    {% if show_changes and o.changes %}<div style="font-size:13px;line-height:1.6;color:#1e7d4f;margin-top:4px;">更新：{{ o.changes }}</div>{% endif %}
  </div>
  {% endfor %}
  <div style="font-size:12px;margin-top:6px;">{% for o in c.sources %}{{ src(o) }}{% if not loop.last %}　{% endif %}{% endfor %}</div>
</div>
{%- endmacro -%}
{%- macro mk(r, key) -%}{% set m = (r.marks or {}).get(key) %}{% if m %}<sup title="{{ m[1] }}" style="color:#b4580a;font-size:9px;margin-left:1px;">{{ m[0] }}</sup>{% endif %}{%- endmacro -%}
{%- macro best(r, key, text) -%}{% if key in r.best %}<b style="color:#1e7d4f;background:#e8f5ec;padding:0 3px;border-radius:3px;">{{ text }}</b>{% else %}{{ text }}{% endif %}{{ mk(r, key) }}{%- endmacro -%}
{#- 規格比較表。電腦版：一排一個選配、固定欄寬、置中。手機版（600px 以下）：一個選配兩排、每排 4 格，上下排欄位固定。
    兩版都是「一格一項規格、單位在表頭、沒資料顯示淡灰 –」。 -#}
{%- macro cell(r, c, mobile=False) -%}{% set txt = c.mtext if mobile else c.text %}{% if txt %}{% if c.best and c.best in r.best %}<b style="color:#1e7d4f;background:#e8f5ec;padding:0 3px;border-radius:3px;">{{ txt }}</b>{% else %}{{ txt }}{% endif %}{% if c.mark %}{{ mk(r, c.mark) }}{% endif %}{% else %}<span style="color:#c9ced6;">–</span>{% endif %}{%- endmacro -%}
{%- macro cmp_name(r, n) -%}
<tr style="background:#eef2f7;border-top:2px solid #cfd6df;">
  <td colspan="{{ n }}" style="padding:7px 8px 5px;font-size:13px;line-height:1.4;text-align:left;">
    <b>{% if r.source_url %}<a href="{{ r.source_url }}" style="color:#1a1a1a;text-decoration:none;">{{ r.label }}</a>{% else %}{{ r.label }}{% endif %}</b>
    <span style="font-size:11px;white-space:nowrap;color:{% if r.score_pct >= 70 %}#1e7d4f{% elif r.score_pct >= 40 %}#8a6100{% else %}#b42318{% endif %};">　規格 {{ r.score }}</span>
    {% if r.updated %}<span style="font-size:11px;color:#1e7d4f;white-space:nowrap;">　● {{ period_label }}有更新</span>{% endif %}
    {% for tg in r.tags or [] %}<span style="font-size:11px;color:#a16207;white-space:nowrap;">　★ {{ tg }}</span>{% endfor %}
    {% if r.price %}<span style="font-size:11px;color:#52514e;white-space:nowrap;">　{{ r.price }}</span>{% endif %}
  </td>
</tr>
{%- endmacro -%}
{%- macro cmp_table(rows) -%}
<table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="border-collapse:collapse;table-layout:fixed;background:#fff;border:1px solid #d5dae1;">
  <colgroup>{% for c in spec_cols %}<col width="{{ c.width }}%">{% endfor %}</colgroup>
  <tr style="background:#1f3a5f;color:#fff;font-size:11px;line-height:1.3;">
    {% for c in spec_cols %}<th style="padding:6px 2px;font-weight:600;text-align:center;">{{ c.head }}<br><span style="font-weight:normal;color:#c7d2e0;">{{ c.unit or "&nbsp;"|safe }}</span></th>{% endfor %}
  </tr>
  {% for r in rows %}{% if r.label %}{{ cmp_name(r, spec_cols|length) }}{% endif %}
  <tr style="border-top:1px solid #edf0f3;">
    {% for c in spec_cols %}<td style="padding:6px 2px;font-size:12px;line-height:1.35;text-align:center;font-variant-numeric:tabular-nums;">{{ cell(r, r.cells[c.key]) }}</td>{% endfor %}
  </tr>
  {% endfor %}
</table>
{%- endmacro -%}
{%- macro cmp_table_m(rows) -%}
<table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="border-collapse:collapse;table-layout:fixed;background:#fff;border:1px solid #d5dae1;">
  <colgroup><col width="30%"><col width="27%"><col width="19%"><col width="24%"></colgroup>
  {% for row in mobile_grid %}{% set top = loop.first %}
  <tr style="background:{{ '#1f3a5f' if top else '#34557d' }};color:#fff;font-size:11px;line-height:1.3;">
    {% for c in row %}<th style="padding:{{ '6px 2px 3px' if top else '3px 2px 6px' }};font-weight:600;text-align:center;">{{ c.head }}{% if c.unit %} <span style="font-weight:normal;color:#c7d2e0;">{{ c.unit }}</span>{% endif %}</th>{% endfor %}
  </tr>
  {% endfor %}
  {% for r in rows %}{% if r.label %}{{ cmp_name(r, 4) }}{% endif %}
  {% for row in mobile_grid %}{% set top = loop.first %}
  <tr style="{% if top %}border-top:1px solid #dfe4ea;{% else %}border-top:1px dotted #edf0f3;{% endif %}">
    {% for c in row %}<td style="padding:{{ '7px 2px 3px' if top else '3px 2px 7px' }};font-size:12.5px;line-height:1.35;text-align:center;vertical-align:middle;font-variant-numeric:tabular-nums;">{{ cell(r, r.cells[c.key], True) }}</td>{% endfor %}
  </tr>
  {% endfor %}
  {% endfor %}
</table>
{%- endmacro -%}
{%- macro cmp_block(rows) -%}
<div class="d-only">{{ cmp_table(rows) }}</div>
<div class="m-only" style="display:none;max-height:0;overflow:hidden;mso-hide:all;">{{ cmp_table_m(rows) }}</div>
{%- endmacro -%}
<!doctype html>
<html lang="zh-Hant"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ subject }}</title>
<style>
/* 手機版（寬度 600px 以下）：比較表改成精簡列表、附錄只留前幾款。不支援的郵件程式會照舊顯示電腦版。 */
@media only screen and (max-width:600px) {
  .d-only { display:none !important; }
  .m-only { display:block !important; max-height:none !important; overflow:visible !important; }
  .wrap { padding:14px 10px !important; }
}
</style></head>
<body style="margin:0;padding:0;background:#f2f4f7;font-family:-apple-system,'Segoe UI','PingFang TC','Microsoft JhengHei',sans-serif;color:#222;">
<div class="wrap" style="max-width:720px;margin:0 auto;padding:20px 14px;background:#f7f8fa;">

  <div style="font-size:21px;font-weight:bold;margin:0 0 2px;">{{ title }}</div>
  <div style="color:#777;font-size:13px;margin-bottom:14px;">{{ date }}（週{{ weekday }}）・{{ period }}</div>
  {% if health %}<div style="font-size:13px;margin:-8px 0 14px;color:#555;">系統狀態：{{ health.icon }} {{ health.summary }}{% if health.level != "ok" %}（見文末「系統健康與資料查核」）{% endif %}</div>{% endif %}

  {#- 關鍵數字：2 欄 × 2 列，手機也排得下 -#}
  <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="border-collapse:separate;border-spacing:6px;">
    {% for row in kpis|batch(2) %}
    <tr>
      {% for k in row %}
      <td width="50%" style="background:#fff;border:1px solid #e3e6ea;border-radius:10px;padding:10px 12px;vertical-align:top;">
        <div style="font-size:12px;color:#777;">{{ k.label }}</div>
        <div style="font-size:22px;font-weight:bold;line-height:1.3;">{{ k.value }}</div>
        <div style="font-size:11px;color:#999;">{{ k.note }}</div>
      </td>
      {% endfor %}
    </tr>
    {% endfor %}
  </table>

  {{ h2(period_label ~ "重點") }}
  <ul style="font-size:14px;line-height:1.75;padding-left:20px;margin:0;">
    {% for h in highlights %}<li>{{ h }}</li>{% endfor %}
  </ul>

  {% if standouts %}
  {{ h2("亮點", "#d08a00") }}
  <ul style="font-size:14px;line-height:1.75;padding-left:20px;margin:0;">
    {% for s in standouts %}<li>{{ s }}</li>{% endfor %}
  </ul>
  {% endif %}

  {% if compare_new %}
  {{ h2("新機規格比較（" ~ new_panels|length ~ " 款）") }}
  <div style="font-size:11px;color:#888;margin:-4px 0 8px;">依尺寸分組；<b style="color:#1e7d4f;background:#e8f5ec;padding:0 3px;border-radius:3px;">綠底</b> 為組內最佳值；* 表示由面板型號推算；小字 <span style="color:#b4580a;">傳</span>＝傳聞、<span style="color:#b4580a;">面</span>＝面板原廠規格、<span style="color:#b4580a;">✎</span>＝人工更正；規格＝13 項重點規格已知幾項。點機型名稱可看來源。</div>
  {% for seg in compare_new %}
  <div style="font-size:13px;font-weight:bold;color:#1f3a5f;margin:12px 0 4px;">{{ seg.name }}（{{ seg.rows|selectattr("label")|list|length }} 款）</div>
  {{ cmp_block(seg.rows) }}
  {% endfor %}
  {% endif %}

  {% if updates %}
  {{ h2("規格更新（" ~ updates|length ~ "）") }}
  {% for c in updates %}{{ card(c, True) }}{% endfor %}
  {% endif %}

  {% if confirmed %}
  {{ h2("傳聞已證實（" ~ confirmed|length ~ "）", "#1e7d4f") }}
  {% for c in confirmed %}{{ card(c, True) }}{% endfor %}
  {% endif %}

  {% if watch_cmp and (watch_cmp.rows or watch_cmp.pending) %}
  {{ h2("關注機型比較（" ~ (watch_cmp.rows|length) ~ " 款已建檔）", "#0f766e") }}
  <div style="font-size:11px;color:#888;margin:-4px 0 8px;">不論有沒有新聞都會追蹤，每月回查；每款顯示資料最完整的選配，完整清單見 Excel。</div>
  {% if watch_cmp.rows %}{{ cmp_block(watch_cmp.rows) }}{% endif %}
  {% if watch_cmp.pending %}<div class="m-only" style="display:none;max-height:0;overflow:hidden;mso-hide:all;font-size:11px;color:#999;margin-top:6px;">另有 {{ watch_cmp.pending|length }} 款尚未建檔，系統會陸續補上（清單見 Excel「關注機型」或電腦版）。</div>
  <div class="d-only" style="font-size:11px;color:#999;margin-top:6px;">尚未建檔：{% for p in watch_cmp.pending %}{{ p.name }}（{{ p.status }}）{% if not loop.last %}、{% endif %}{% endfor %}</div>{% endif %}
  {% endif %}

  {% if platform %}
  {{ h2("平台技術動態（" ~ platform|length ~ "）") }}
  {% for r in platform %}
  <div style="border:1px solid #e3e6ea;border-radius:10px;padding:12px 14px;margin:0 0 10px;background:#fff;">
    <div style="font-size:15px;font-weight:bold;">{{ r.vendor }}｜{{ r.tech }}</div>
    <div style="margin:4px 0;">{{ badge(r.conf_code, r.confidence) }} <span style="font-size:12px;color:#777;">{{ r.category }}</span></div>
    <div style="font-size:14px;line-height:1.6;">{{ r.summary }}</div>
    {% if r.affected %}<div style="font-size:12px;color:#777;margin-top:4px;">影響規格：{{ r.affected }}</div>{% endif %}
    <div style="font-size:12px;margin-top:6px;">{{ src(r) }}</div>
  </div>
  {% endfor %}
  {% endif %}

  {% if fabs or industry %}
  {{ h2("面板廠與產業動態") }}
  {% for r in fabs %}
  <div style="border:1px solid #e3e6ea;border-radius:10px;padding:12px 14px;margin:0 0 10px;background:#fff;">
    <div style="font-size:15px;font-weight:bold;">{{ r.maker }} {{ r.site }} {{ r.gen }} {{ r.tech }}</div>
    <div style="font-size:12px;color:#777;margin:4px 0;">狀態：{{ r.status }}{% if r.milestone %}・{{ r.milestone }}{% endif %}{% if r.capacity %}・月產能 {{ "{:,}".format(r.capacity) }} 片{% endif %}</div>
    <div style="font-size:14px;line-height:1.6;">{{ r.summary }}</div>
    <div style="font-size:12px;margin-top:6px;">{{ src(r) }}</div>
  </div>
  {% endfor %}
  {% for r in industry %}
  <p style="font-size:14px;line-height:1.6;margin:8px 0;">・{{ r.note }} {{ src(r) }}</p>
  {% endfor %}
  {% endif %}

  {{ h2("市場分析", "#5b3fa8") }}
  {% if wow %}
  <div style="font-size:14px;font-weight:bold;margin:4px 0 6px;">與{{ prev_label }}比較</div>
  <table role="presentation" cellpadding="6" cellspacing="0" width="100%" style="border-collapse:collapse;font-size:13px;background:#fff;border:1px solid #e3e6ea;">
    <tr style="background:#eef0f6;text-align:left;"><th>指標</th><th>{{ prev_label }}</th><th>{{ period_label }}</th><th>變化</th></tr>
    {% for w in wow %}
    <tr style="border-top:1px solid #e3e6ea;"><td>{{ w.metric }}</td><td>{{ w.prev }}</td><td><b>{{ w.now }}</b></td>
      <td style="color:{% if w.arrow == '▲' %}#1e7d4f{% elif w.arrow == '▼' %}#b42318{% else %}#777{% endif %};">{{ w.arrow }} {{ w.delta }}</td></tr>
    {% endfor %}
  </table>
  {% else %}
  <p style="font-size:13px;color:#888;margin:4px 0;">與{{ prev_label }}比較：資料累積中，下期開始顯示。</p>
  {% endif %}

  {% if mentions %}
  <div style="font-size:14px;font-weight:bold;margin:16px 0 6px;">技術提及率</div>
  <table role="presentation" cellpadding="6" cellspacing="0" width="100%" style="border-collapse:collapse;font-size:13px;background:#fff;border:1px solid #e3e6ea;">
    <tr style="background:#eef0f6;text-align:left;"><th>技術</th><th>{{ period_label }}</th><th>前 30 天</th></tr>
    {% for m in mentions %}
    <tr style="border-top:1px solid #e3e6ea;"><td>{{ m.feature }}<div style="font-size:11px;color:#999;">{{ m.desc }}</div></td><td><b>{{ m.share }}</b>（{{ m.count }} 款）</td><td>{{ m.base_share }}</td></tr>
    {% endfor %}
  </table>
  <div style="font-size:11px;color:#999;margin-top:4px;">提及率＝新機型報導中有提到該技術的比例；報導沒提到不代表沒有。</div>
  {% endif %}

  {% if matrix %}
  <div style="font-size:14px;font-weight:bold;margin:16px 0 6px;">品牌 × 面板廠（累計 {{ matrix.total }} 款）</div>
  <table role="presentation" cellpadding="6" cellspacing="0" width="100%" style="border-collapse:collapse;font-size:13px;background:#fff;border:1px solid #e3e6ea;">
    <tr style="background:#eef0f6;text-align:left;"><th>品牌</th>{% for m in matrix.makers %}<th>{{ m }}</th>{% endfor %}</tr>
    {% for r in matrix.rows %}
    <tr style="border-top:1px solid #e3e6ea;"><td>{{ r.brand }}</td>{% for v in r.cells %}<td style="text-align:center;{% if v %}font-weight:bold;{% else %}color:#ccc;{% endif %}">{{ v if v else "·" }}</td>{% endfor %}</tr>
    {% endfor %}
  </table>
  {% if matrix.inferred %}<div style="font-size:11px;color:#999;margin-top:4px;">其中 {{ matrix.inferred }} 款的面板廠由面板型號推算。</div>{% endif %}
  {% else %}
  <p style="font-size:13px;color:#888;margin:12px 0 4px;">品牌 × 面板廠：目前報導中提到面板廠的機型還不多，資料累積中。</p>
  {% endif %}

  {% if to_fill %}
  <div style="font-size:14px;font-weight:bold;margin:16px 0 6px;">規格待補清單</div>
  <table role="presentation" cellpadding="6" cellspacing="0" width="100%" style="border-collapse:collapse;font-size:13px;background:#fff;border:1px solid #e3e6ea;">
    <tr style="background:#eef0f6;text-align:left;"><th>機型</th><th>完整度</th></tr>
    {% for t in to_fill %}
    <tr style="border-top:1px solid #e3e6ea;"><td>{{ t.name }}<div style="font-size:11px;color:#999;">缺：{{ t.missing }}</div></td><td>{{ t.score }}</td></tr>
    {% endfor %}
  </table>
  <div style="font-size:11px;color:#999;margin-top:4px;">系統會自動回頭補查這些機型的官方規格頁與評測；面板廠與型號通常要等評測或拆機才會公開。</div>
  {% endif %}

  {% if price_matrix %}
  <div style="font-size:14px;font-weight:bold;margin:16px 0 6px;">價位帶 × 規格（{{ price_matrix.priced }} 款有標價）</div>
  <div style="overflow-x:auto;">
  <table role="presentation" cellpadding="5" cellspacing="0" width="100%" style="border-collapse:collapse;font-size:12px;background:#fff;border:1px solid #e3e6ea;">
    <tr style="background:#eef0f6;text-align:left;"><th>價位帶（起價）</th><th style="text-align:right;">款數</th><th style="text-align:right;">OLED</th>
      <th style="text-align:right;">≥120Hz</th><th style="text-align:right;">≥2.5K</th><th style="text-align:right;">觸控</th><th style="text-align:right;">SDR 中位數</th></tr>
    {% for r in price_matrix.rows %}
    <tr style="border-top:1px solid #e3e6ea;vertical-align:top;"><td style="white-space:nowrap;">{{ r.band }}<div style="font-size:10.5px;color:#999;white-space:normal;">{{ r.examples }}</div></td>
      <td style="text-align:right;">{{ r.n }}</td>
      {% for v in [r.oled, r.hz120, r.res25, r.touch] %}<td style="text-align:right;">{% if v[0] is not none %}{{ v[0] }}%<div style="font-size:10px;color:#aaa;">n={{ v[1] }}</div>{% else %}<span style="color:#bbb;">—</span>{% endif %}</td>{% endfor %}
      <td style="text-align:right;">{{ r.sdr ~ " nits" if r.sdr else "—" }}</td></tr>
    {% endfor %}
  </table>
  </div>
  <div style="font-size:11px;color:#999;margin-top:4px;">以機型為單位、取最低起價，非美元以概略匯率換算（config.yaml 的 price 可調整）；比例只計算有標示該規格的機型（n）。</div>
  {% endif %}

  {% if quarterly and quarterly.dims %}
  <div style="font-size:14px;font-weight:bold;margin:16px 0 6px;">季度趨勢（新機規格分布）</div>
  <div style="font-size:11px;color:#999;margin-bottom:6px;">
    各季機型數：{% for q in quarterly.quarters %}{{ q }} {{ quarterly.models[q] }} 款{% if not loop.last %}、{% endif %}{% endfor %}。
    {% if not quarterly.comparable %}目前可比較的季度不足（每季需 5 款以上），季對季變化待資料累積後顯示。{% endif %}
  </div>
  {% for d in quarterly.dims %}
  {#- 100% 堆疊橫條：每季一條；顏色跟著類別走，圖例在上，數字表在下 -#}
  <div style="background:#fff;border:1px solid #e3e6ea;border-bottom:0;padding:8px 8px 4px;">
    <div style="font-size:12.5px;font-weight:bold;color:#222;margin-bottom:4px;">{{ d.name }}</div>
    <div style="font-size:11px;color:#52514e;line-height:1.9;">{% for l in d.legend %}<span style="white-space:nowrap;margin-right:10px;"><span style="display:inline-block;width:9px;height:9px;border-radius:2px;background:{{ l.color }};vertical-align:-1px;margin-right:3px;"></span>{{ l.name }}</span>{% endfor %}</div>
    <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="border-collapse:collapse;font-size:11px;margin-top:2px;">
      {% for row in d.rows %}
      <tr>
        <td style="width:64px;white-space:nowrap;color:#52514e;padding:3px 6px 3px 0;">{{ row.quarter }}</td>
        <td style="padding:3px 0;">
          {% if row.segments %}
          <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="border-collapse:collapse;table-layout:fixed;"><tr>
            {% for s in row.segments %}<td width="{{ s.pct }}%" title="{{ s.name }} {{ '%.0f'|format(s.pct) }}%" style="background:{{ s.color }};height:18px;border-right:2px solid #fff;{% if loop.first %}border-radius:4px 0 0 4px;{% endif %}{% if loop.last %}border-right:0;border-radius:0 4px 4px 0;{% endif %}color:{{ s.ink }};font-size:10px;text-align:center;overflow:hidden;white-space:nowrap;">{% if s.pct >= 14 %}{{ '%.0f'|format(s.pct) }}%{% endif %}</td>{% endfor %}
          </tr></table>
          {% else %}<span style="color:#999;">無資料</span>{% endif %}
        </td>
        <td style="width:38px;text-align:right;color:#999;padding-left:6px;white-space:nowrap;">n={{ row.n }}</td>
      </tr>
      {% endfor %}
    </table>
  </div>
  <table role="presentation" cellpadding="5" cellspacing="0" width="100%" style="border-collapse:collapse;font-size:12px;background:#fff;border:1px solid #e3e6ea;margin-bottom:10px;">
    <tr style="background:#eef0f6;text-align:left;"><th>{{ d.name }}</th>{% for b in d.buckets %}<th style="text-align:right;">{{ b }}</th>{% endfor %}</tr>
    {% for row in d.rows %}
    <tr style="border-top:1px solid #e3e6ea;"><td style="white-space:nowrap;">{{ row.quarter }} <span style="color:#999;">n={{ row.n }}</span></td>
      {% for b in d.buckets %}<td style="text-align:right;">{% if row.share[b] is not none %}{{ "%.0f"|format(row.share[b] * 100) }}%{% else %}—{% endif %}</td>{% endfor %}</tr>
    {% endfor %}
    {% if d.shift %}
    <tr style="border-top:1px solid #e3e6ea;background:#fafbfc;"><td>季變化</td>
      {% for b in d.buckets %}{% set v = d.shift[b] %}<td style="text-align:right;color:{% if v > 0 %}#1e7d4f{% elif v < 0 %}#b42318{% else %}#999{% endif %};">{% if v > 0 %}▲{{ v }}{% elif v < 0 %}▼{{ -v }}{% else %}＝{% endif %}</td>{% endfor %}</tr>
    {% endif %}
  </table>
  {% endfor %}
  {% if backfill %}<div style="font-size:11px;color:#999;margin-top:2px;">歷史回溯進度：{% for q, v in backfill.quarters.items() %}{{ q }} {{ v }}{% if not loop.last %}、{% endif %}{% endfor %}{% if backfill.added %}；{{ period_label }}回溯補進 {{ backfill.added }} 款（不列入上方新機）{% endif %}{% if backfill.done == 0 %}；{{ backfill.start_on }} 起自動執行{% endif %}。</div>{% endif %}
  <div style="font-size:11px;color:#999;margin-top:2px;">占比只計算有標示該規格的機型；季變化單位為百分點。季度依發表／上市時間判斷，沒寫則用新聞日期；關注清單的既有機型若無時間不計入。</div>
  {% endif %}

  {% if trend %}
  <div style="font-size:14px;font-weight:bold;margin:16px 0 6px;">近 30 天分布（{{ trend.count }} 款）</div>
  <p style="font-size:13px;line-height:1.75;margin:0;">
    面板技術：{% for k, v in trend.tech %}{{ k }} {{ v }}{% if not loop.last %}、{% endif %}{% endfor %}<br>
    {% if trend.refresh %}常見刷新率：{% for k, v in trend.refresh %}{{ k }}（{{ v }}）{% if not loop.last %}、{% endif %}{% endfor %}<br>{% endif %}
    {% if trend.makers %}面板廠：{% for k, v in trend.makers %}{{ k }}（{{ v }}）{% if not loop.last %}、{% endif %}{% endfor %}{% endif %}
  </p>
  {% endif %}

  {% if rumor_panels or platform_rumors or fab_rumors or rumor_tracker %}
  {{ h2("傳聞與爆料（未經證實）", "#b4580a") }}
  {% for c in rumor_panels %}{% if loop.index > 5 %}<div class="d-only">{{ card(c) }}</div>{% else %}{{ card(c) }}{% endif %}{% endfor %}
  {% if rumor_panels|length > 5 %}<div class="m-only" style="display:none;max-height:0;overflow:hidden;mso-hide:all;font-size:12px;color:#888;margin:0 0 8px;">手機版只顯示 5 則，其餘 {{ rumor_panels|length - 5 }} 則見電腦版。</div>{% endif %}
  {% for r in platform_rumors %}<p style="font-size:14px;margin:8px 0;">・<b>{{ r.vendor }} {{ r.tech }}</b>：{{ r.summary }} {{ src(r) }}</p>{% endfor %}
  {% for r in fab_rumors %}<p style="font-size:14px;margin:8px 0;">・<b>{{ r.maker }} {{ r.gen }}</b>：{{ r.summary }} {{ src(r) }}</p>{% endfor %}
  {% if rumor_tracker %}
  <div style="font-size:14px;font-weight:bold;margin:12px 0 6px;">傳聞追蹤（近 90 天尚未證實）</div>
  <table role="presentation" cellpadding="6" cellspacing="0" width="100%" style="border-collapse:collapse;font-size:13px;background:#fff;border:1px solid #e3e6ea;">
    <tr style="background:#fdf3e7;text-align:left;"><th>傳聞</th><th>首次出現</th><th>已過</th></tr>
    {% for t in rumor_tracker %}
    <tr style="border-top:1px solid #e3e6ea;"><td>{% if t.source_url %}<a href="{{ t.source_url }}" style="color:#1f5fa8;text-decoration:none;">{{ t.name }}</a>{% else %}{{ t.name }}{% endif %}<div style="font-size:11px;color:#999;">{{ t.detail }}</div></td><td>{{ t.first_seen }}</td><td>{{ t.days }} 天</td></tr>
    {% endfor %}
  </table>
  {% endif %}
  {% endif %}

  {% if new_panels %}
  {{ h2("新機詳細規格（" ~ new_panels|length ~ "）", "#64748b") }}
  <div style="font-size:12px;color:#888;margin:-4px 0 8px;">{{ panel_known }} 款已知面板來源。🖥 螢幕　☀ 亮度　🎨 色域　◻ 表面處理　👆 觸控　🏭 面板廠與型號</div>
  {% for c in appendix %}{% if loop.index > mobile_cards %}<div class="d-only">{{ card(c) }}</div>{% else %}{{ card(c) }}{% endif %}{% endfor %}
  {% if appendix|length > mobile_cards %}<div class="m-only" style="display:none;max-height:0;overflow:hidden;mso-hide:all;font-size:12px;color:#888;margin:4px 0 0;">手機版只顯示有亮點、資料最完整的前 {{ mobile_cards }} 款；其餘 {{ appendix|length - mobile_cards }} 款的詳細規格見 Excel 附件或電腦版。</div>{% endif %}
  {% endif %}

  {% if ongoing %}
  {{ h2("持續討論中", "#999") }}
  {% for group in ongoing %}
  <p style="font-size:14px;margin:8px 0 4px;"><b>{{ group.label }}</b>（{{ period_label }}無新消息）</p>
  {% if group.entries %}
  <ul style="font-size:13px;line-height:1.6;padding-left:20px;margin-top:0;">
    {% for it in group.entries %}<li>{{ it.title }} <span style="color:#777;">最後出現 {{ it.date }}</span>{% if it.source_url %} <a href="{{ it.source_url }}" style="color:#1f5fa8;text-decoration:none;">來源</a>{% endif %}</li>{% endfor %}
  </ul>
  {% else %}<p style="font-size:13px;color:#777;margin-top:0;">近期也沒有相關紀錄。</p>{% endif %}
  {% endfor %}
  {% endif %}

  {% if health %}
  {{ h2("系統健康與資料查核　" ~ health.icon, "#475569") }}
  <div style="font-size:12px;color:#888;margin:-4px 0 8px;">全部由程式檢查，不花 AI 額度。🟢 正常　🟡 注意　🔴 需處理</div>
  {% for title, rows in [("運作狀況", health.ops), ("資料正確性", health.quality)] %}
  <div style="font-size:14px;font-weight:bold;margin:10px 0 4px;">{{ title }}{% set n_ok = rows|selectattr("level", "equalto", "ok")|list|length %}{% if n_ok %}<span class="m-only" style="display:none;max-height:0;overflow:hidden;mso-hide:all;font-size:12px;font-weight:normal;color:#888;">　另 {{ n_ok }} 項正常</span>{% endif %}</div>
  <table role="presentation" cellpadding="5" cellspacing="0" width="100%" style="font-size:13px;line-height:1.5;border-collapse:collapse;">
    {% for c in rows %}
    <tr {% if c.level == "ok" %}class="d-only" {% endif %}style="border-bottom:1px solid #eef0f2;">
      <td style="width:22px;vertical-align:top;">{{ c.icon }}</td>
      <td style="width:84px;vertical-align:top;font-weight:bold;white-space:nowrap;">{{ c.name }}</td>
      <td style="vertical-align:top;">{{ c.detail }}
        {% if c.notes %}<ul style="margin:4px 0 0;padding-left:18px;color:#666;font-size:12px;">{% for it in c.notes %}<li {% if loop.index > 3 %}class="d-only"{% endif %}>{{ it }}</li>{% endfor %}{% if c.notes|length > 3 %}<li class="m-only" style="display:none;max-height:0;overflow:hidden;mso-hide:all;list-style:none;margin-left:-18px;color:#999;">…另 {{ c.notes|length - 3 }} 項見電腦版或 Excel「資料查核」</li>{% endif %}</ul>{% endif %}
      </td>
    </tr>
    {% endfor %}
  </table>
  {% endfor %}
  {% if health.audit %}
  <div class="m-only" style="display:none;max-height:0;overflow:hidden;mso-hide:all;font-size:12px;color:#888;margin-top:10px;">抽樣稽核（{{ health.audit|length }} 款）見電腦版或 Excel「資料查核」。</div>
  <div class="d-only">
  <div style="font-size:14px;font-weight:bold;margin:14px 0 4px;">抽樣稽核（本週隨機 {{ health.audit|length }} 款，點來源 1 分鐘可核對）</div>
  {% for a in health.audit %}
  <div style="border-left:3px solid #cbd5e1;padding:4px 10px;margin:0 0 8px;font-size:13px;line-height:1.6;">
    <b>{{ a.model }}</b> <span style="color:#888;font-size:12px;">{{ a.confidence }}</span>
    {% for ln in a.lines %}<div>{{ ln.field }}＝<b>{{ ln.value }}</b>　<span style="color:#777;">原文：「{{ ln.quote }}」</span></div>{% endfor %}
    <a href="{{ a.source_url }}" style="color:#1f5fa8;text-decoration:none;font-size:12px;">{{ a.source_name or "來源" }} ›</a>
  </div>
  {% endfor %}
  </div>
  {% endif %}
  {% endif %}

  {% if glossary %}
  <div class="d-only">
  {{ h2("名詞小辭典", "#999") }}
  <table role="presentation" cellpadding="4" cellspacing="0" width="100%" style="font-size:12px;line-height:1.6;color:#555;">
    {% for term, desc in glossary %}<tr><td style="white-space:nowrap;vertical-align:top;font-weight:bold;padding-right:8px;">{{ term }}</td><td>{{ desc }}</td></tr>{% endfor %}
  </table>
  </div>
  {% endif %}

  <hr style="border:none;border-top:1px solid #e3e6ea;margin:24px 0 12px;">
  <p style="font-size:12px;color:#888;line-height:1.7;">
    可信度：{{ badge("A", "官方") }} 品牌或廠商公布　{{ badge("B", "實測") }} 評測或拆機　{{ badge("C", "媒體報導") }} 媒體或彙整　{{ badge("D", "傳聞") }} 社群爆料<br>
    每個數值都經過原文比對；PPI、長寬比、像素密度由程式計算；標示「推算」的面板廠與尺寸由面板型號推得。<br>
    完整規格表見附件 Excel。本報告由 Display Intel agent 自動產生。
  </p>
</div>
</body></html>
